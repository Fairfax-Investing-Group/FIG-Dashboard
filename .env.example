# Supabase project URL and browser-safe publishable key (Settings > API Keys).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon keys are supported via VITE_SUPABASE_ANON_KEY instead.
# Never put a Supabase secret/service-role key or database password in a VITE_ variable.

# Hosted Python API origin, e.g. https://your-study-api.onrender.com
# Leave blank locally; Vite proxies /api to the local Python server.
VITE_STUDY_API_URL=
