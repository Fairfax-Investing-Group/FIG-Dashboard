SEC_USER_AGENT=Fairfax Investing Group Thomas Duong thomas@fairfaxinvestinggroup.com
FINANCIAL_DATA_DIR=data
# Defaults to local files and a local SQLite Iceberg catalog. No remote creation.
FINANCIAL_STORAGE=local
# For existing R2 buckets + an enabled Basin catalog, set all of:
# FINANCIAL_STORAGE=r2
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_RAW_BUCKET=financial-raw
# R2_LAKE_BUCKET=financial-lake
# BASIN_CATALOG_URI=<copy exact catalog URI from Cloudflare>
# BASIN_WAREHOUSE=<copy exact warehouse from Cloudflare>
# BASIN_TOKEN=
# FINANCIAL_STORAGE_LIMIT_BYTES=9000000000

